+def eq_bands_of(f: OneMoreFrame) -> list[tuple[int, int, int, int]] | None:
+    """(enable, gain, freq, q) из кадра 0x54.
+    Возвращает список из 10 кортежей только если frame.cmd == 0x54,
+    direction_byte в {0x01, 0x11} и len(payload) == 70.
+    Поля записи: enable = payload[0], gain = u16 BE [1:3], freq = u16 BE [3:5], q = u16 BE [5:7].
+    В остальных случаях None."""
+    p = f.payload
+    if f.cmd != CMD_EQ_BANDS or f.direction_byte not in (0x01, 0x11) or len(p) != 70:
+        return None
+    bands = []
+    for i in range(10):
+        off = i * 7
+        enable = p[off]
+        gain = struct.unpack(">H", p[off + 1 : off + 3])[0]
+        freq = struct.unpack(">H", p[off + 3 : off + 5])[0]
+        q = struct.unpack(">H", p[off + 5 : off + 7])[0]
+        bands.append((enable, gain, freq, q))
+    return bands
+
+
 def decode_value(f: OneMoreFrame) -> str:
     p = f.payload
     if not p:
@@ -424,6 +444,10 @@ def decode_value(f: OneMoreFrame) -> str:
