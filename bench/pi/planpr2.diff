--- a/calc.py
+++ b/calc.py
@@ -1,6 +1,10 @@
 def percent(part, whole):
+    if whole == 0:
+        return 0.0
     return part / whole * 100
 
 
 def average(values):
+    if not values:
+        return 0.0
     return sum(values) / len(values)
